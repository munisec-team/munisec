alert http any any -> $HOME_NET any (msg:"Sensitive endpoint /backup"; flow:established,to_server; http.uri; content:"/backup"; nocase; detection_filter:track by_src, count 10, seconds 30; sid:1200009; rev:1;)

alert http any any -> $HOME_NET any (msg:"Sensitive file exposure"; flow:established,to_server; http.uri; pcre:"/\.(env|bak|sql|zip|tar|gz|log|ini|conf|db)$/i"; sid:1200010; rev:1;)

alert http any any -> $EXTERNAL_NET any (msg:"CLI tool UA (curl/wget)"; flow:established,to_server; http.user_agent; pcre:"/(curl|wget)/i"; detection_filter:track by_src, count 10, seconds 60; sid:1200011; rev:1;)

alert http any any -> $EXTERNAL_NET any (msg:"Fuzzing tool UA (gobuster/ffuf)"; flow:established,to_server; http.user_agent; pcre:"/(gobuster|ffuf|feroxbuster|dirbuster)/i"; detection_filter:track by_src, count 5, seconds 60; sid:1200012; rev:1;)

