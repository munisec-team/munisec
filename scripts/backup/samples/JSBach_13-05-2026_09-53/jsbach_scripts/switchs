#!/bin/bash

source /usr/local/JSBach/conf/variables.conf
source $DIR/$DIR_PROJECTE/$DIR_SCRIPTS/$FUNCIONS
source /usr/local/bin/jsbach-logger.sh

######################################################################
###  Funcions
######################################################################

fnc_iniciar() {
    fnc_modifica_totes_acl_admin
    fnc_afegir_macs_totes_acls
    log_action "SWITCHES" "INICIAR" "SE HAN APLICADO ACLs EN LOS SWITCHES"
}

fnc_aturar() {
    fnc_reset_totes_acls
    log_action "SWITCHES" "PARAR" "SE HAN DESAPLICADO ACLs EN LOS SWITCHES"
}

fnc_ping_switch() {
    if ping -c 1 -W 1 "$1" > /dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

fnc_estat() {
    for linia in $(grep -v '#' "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS"); do
        nom=$(echo "$linia" | cut -d';' -f1)
        ip=$(echo "$linia" | cut -d';' -f2)
        if fnc_ping_switch "$ip"; then
            echo "$nom $ip FUNCIONA"
        else
            echo "$nom $ip NO_RESPON"
        fi
    done
    log_action "SWITCHES" "ESTADO" "SE HA MOSTRADO EL ESTADO DE LOS SWITCHES"
}

fnc_estat_acls() {
    for linia in $(grep -v '#' "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS"); do
        nom=$(echo "$linia" | cut -d';' -f1)
        ip=$(echo "$linia" | cut -d';' -f2)
        user=$(echo "$linia" | cut -d';' -f3)
        pass=$(echo "$linia" | cut -d';' -f4)
        protocol=$(echo "$linia" | cut -d';' -f5)
        MOSTRAR="$nom $ip "
        if ! fnc_ping_switch "$ip"; then
            MOSTRAR+="NO_RESPON"
            echo "$MOSTRAR"
            continue
        fi

        RESULTAT=$(fnc_expect_comand "$ip" "$user" "$pass" "$nom" "$protocol" "show access-list")

        if echo "$RESULTAT" | grep -q "ACL_1"; then
            MOSTRAR+="ACL_ADMIN "
        else
            MOSTRAR+="NO_ACL_ADMIN "
        fi
        if echo "$RESULTAT" | grep -q "ACL_2"; then
            MOSTRAR+="ACL_MACS "
        else
            MOSTRAR+="NO_ACL_MACS "
        fi
        echo "$MOSTRAR"
    done
}

fnc_totes_les_taula_mac() {
    for linia in $(grep -v '#' "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS"); do
        nom=$(echo "$linia" | cut -d';' -f1)
        ip=$(echo "$linia" | cut -d';' -f2)
        user=$(echo "$linia" | cut -d';' -f3)
        pass=$(echo "$linia" | cut -d';' -f4)
        protocol=$(echo "$linia" | cut -d';' -f5)
        if ! fnc_ping_switch "$ip"; then
            echo "Switch $nom $ip NO_RESPON"
            continue
        fi
        fnc_expect_comand "$ip" "$user" "$pass" "$nom" "$protocol" "show mac address-table"
    done
}

fnc_expect_comand() {

    if [ $# -lt 5 ]; then
        echo "Error expect falta ip_switch user pass nom mode comand"
        exit 1
    fi

    IP="$1"
    USER="$2"
    PASS="$3"
    NOM="$4"
    MODE="$5"
    COMAND="$6"

    if [ "$MODE" == "telnet" ]; then
        SPAWN_CMD="telnet $IP"
        LOGIN_EXPECT="\"*ser*\" { send \"$USER\r\"; send \"$PASS\r\" }"
    else
        SPAWN_CMD="ssh -o StrictHostKeyChecking=no $USER@$IP"
        LOGIN_EXPECT="\"*assword:*\" { send \"$PASS\r\" }"
    fi

    echo "Switch $NOM $IP"
    expect << EOF | sed -n "\|$COMAND|,\$p" | sed '1d' | sed '/#\|>/,$d'
set timeout 10
log_user 1

spawn $SPAWN_CMD

expect {
    $LOGIN_EXPECT
}

# Esperem el prompt inicial (>)
expect ">"
send "enable\r"

# Prompt en mode privilegiat (#)
expect "#"
send "$COMAND\r"

# Tornem a esperar el prompt
expect "#"
send "exit\r"

expect ">"
send "exit\r"

expect eof
EOF

    log_action "SWITCHES" "CONFIG" "SE HAN MANDADO CONSULTAS AL SWITCH [$4]"
}

fnc_reset_acl() {
    if [ $# -lt 5 ]; then
        echo "Error reset_acl falta ip_switch user pass nom acl_id mode"
        exit 1
    fi

    IP="$1"
    USER="$2"
    PASS="$3"
    NOM="$4"
    ACL="$5"
    MODE="$6"

    if [ "$MODE" == "telnet" ]; then
        SPAWN_CMD="telnet $IP"
        LOGIN_EXPECT="\"*ser*\" { send \"$USER\r\"; send \"$PASS\r\" }"
    else
        SPAWN_CMD="ssh -o StrictHostKeyChecking=no $USER@$IP"
        LOGIN_EXPECT="\"*assword:*\" { send \"$PASS\r\" }"
    fi

    echo "Eliminant ACL $ACL al switch $NOM ($IP)"
    expect << EOF
set timeout 10
log_user 0

spawn $SPAWN_CMD

expect {
    $LOGIN_EXPECT
    "*assword:*" {
        send "$PASS\r"
    }
}

expect ">"
send "enable\r"

expect "#"
send "conf\r"

expect "(config)#"
send "no access-list bind $ACL\r"

expect "(config)#"
send "no access-list create $ACL\r"

expect "(config)#"
send "exit\r"

expect "#"
send "exit\r"

expect ">"
send "exit\r"

expect eof
EOF
log_action "SWITCHES" "CONFIG" "SE HAN LIMPIADO LAS ACLs DEL SWITCH $1"
}

fnc_reset_totes_acls() {
    for linia in $(grep -v '#' "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS"); do
        nom=$(echo "$linia" | cut -d';' -f1)
        ip=$(echo "$linia" | cut -d';' -f2)
        user=$(echo "$linia" | cut -d';' -f3)
        pass=$(echo "$linia" | cut -d';' -f4)
        protocol=$(echo "$linia" | cut -d';' -f5)
        if ! fnc_ping_switch "$ip"; then
            echo "Switch $nom $ip NO_RESPON"
            continue
        fi
        fnc_reset_acl "$ip" "$user" "$pass" "$nom" "1" "$protocol"
        fnc_reset_acl "$ip" "$user" "$pass" "$nom" "2" "$protocol"
    done
    log_action "SWITCHES" "CONFIG" "SE HAN RESETEADO TODAS LAS ACLs"
}

fnc_afegir_macs_acl() {
    if [ $# -lt 5 ]; then
        echo "Error afegir_macs_acl falta ip_switch user pass nom  mode"
        exit 1
    fi

    IP="$1"
    USER="$2"
    PASS="$3"
    NOM="$4"
    MODE="$5"

    if [ "$MODE" == "telnet" ]; then
        SPAWN_CMD="telnet $IP"
        LOGIN_EXPECT="\"*ser*\" { send \"$USER\r\"; send \"$PASS\r\" }"
    else
        SPAWN_CMD="ssh -o StrictHostKeyChecking=no $USER@$IP"
        LOGIN_EXPECT="\"*assword:*\" { send \"$PASS\r\" }"
    fi

    local MAC_COMMANDS=""
    RULE=1
    if [ -f "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS_MACS_BLOCADES" ]; then
        while read -r mac; do
            [ -z "$mac" ] && continue
            MAC_COMMANDS+="expect \"(config)#\"\nsend \"access-list mac 2 rule $RULE deny logging disable smac $mac smask ff:ff:ff:ff:ff:ff\r\"\n"
            RULE=$((RULE + 1))
        done < "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS_MACS_BLOCADES"
    fi

    echo "Modificant ACL al switch $NOM ($IP)"
    expect << EOF
set timeout 10
log_user 0

spawn $SPAWN_CMD

expect {
    $LOGIN_EXPECT
}

expect ">"
send "enable\r"

expect "#"
send "conf\r"

expect "(config)#"
send "no access-list bind 2\r"

expect "(config)#"
send "no access-list create 22\r"

expect "(config)#"
send "access-list create 2\r"

$(printf "$MAC_COMMANDS")

expect "(config)#"
send "access-list mac 2 rule $RULE  permit logging disable\r"

expect "(config)#"
send "access-list bind 2 interface gigabitEthernet 1/0/1-7\r"

expect "(config)#"
send "exit\r"

expect "#"
send "exit\r"

expect ">"
send "exit\r"

expect eof
EOF


}

fnc_afegir_macs_totes_acls() {
    for linia in $(grep -v '#' "$DIR/$DIR_PROJECTE/$DIR_CONF/$SWITCHS"); do
        nom=$(echo "$linia" | cut -d';' -f1)
        ip=$(echo "$linia" | cut -d';' -f2)
        user=$(echo "$linia" | cut -d';' -f3)
        pass=$(echo "$linia" | cut -d';' -f4)
        protocol=$(echo "$linia" | cut -d';' -f5)
        if ! fnc_ping_switch "$ip"; then
            echo "Switch $nom $ip NO_RESPON"
            continue
        fi
        fnc_afegir_macs_acl "$ip" "$user" "$pass" "$nom" "$protocol"
    done
}

